# Дефолтні ключі для лабораторної роботи 1 (шифри заміни та перестановки).
# Це НЕ секрети — навчальні значення, які лише підставляються як постійний
# ключ кожного шифру, щоб не передавати -k щоразу вручну. Скопіюйте у .env
# і за потреби відредагуйте; .env у git не комітиться.

LAB1_SUBSTITUTION_KEY=КРИПТОГРАФІЯ
LAB1_VIGENERE_KEY=КЛЮЧ
LAB1_BLOCK_PERMUTATION_KEY=3 2 5 1 4
LAB1_COLUMNAR_KEY=3 1 4 2
# Seed відтворюваності для гомофонної підстановки (розділ 4.3), не секрет;
# залиште порожнім, щоб кожного разу використовувалась системна
# криптографічна випадковість.
LAB1_HOMOPHONIC_SEED=
